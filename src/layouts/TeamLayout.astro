---
import Layout from './Layout.astro';

interface Props {
    title: string;
    message?: string;
}

const { title, message } = Astro.props;
const defaultMessage = 'Member names, roles, photos, and biographies for this team are still being gathered. Check back soon.';
---

<Layout title={title}>
    <h1>{title}</h1>
    <p class="mt-6 max-w-prose text-lg text-accent">{message ?? defaultMessage}</p>
</Layout>
