---
import '../styles/globals.css';
import '@fontsource-variable/newsreader/wght.css';
import newsreaderWoff2 from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../config/site';
import CursorTrail from '../components/CursorTrail.astro';

interface Props {
    title: string;
    variant?: 'default' | 'stage';
}

const { title, variant = 'default' } = Astro.props;
const isStage = variant === 'stage';
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <title>{title} | {SITE.name}</title>
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="preload" as="font" type="font/woff2" href={newsreaderWoff2} crossorigin />
    </head>
    <body class="flex flex-col min-h-screen text-ink bg-paper antialiased" data-cursor-tone="light">
        <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded focus:bg-ink focus:px-4 focus:py-2 focus:text-paper">
            Skip to content
        </a>
        <div class:list={['flex flex-col w-full mx-auto grow', { 'max-w-5xl px-6 sm:px-12': !isStage }]}>
            <Header tone={isStage ? 'dark' : 'light'} />
            <main id="main-content" class:list={['grow', { 'py-12 sm:py-16': !isStage }]}>
                <slot />
            </main>
            <div class:list={{ 'w-full max-w-7xl mx-auto px-6 sm:px-12': isStage }}>
                <Footer />
            </div>
        </div>
        <CursorTrail />
    </body>
</html>
