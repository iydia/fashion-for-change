---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../config/site';
---

<Layout title="Home">
    <section class="py-8 sm:py-16">
        <p class="text-sm font-medium tracking-wide uppercase text-accent">University of Waterloo</p>
        <h1 class="mt-2">{SITE.name}</h1>
        <a href={SITE.linktree} target="_blank" rel="noopener noreferrer" class="btn mt-8">
            Join FC
            <span class="sr-only">(opens in a new tab)</span>
        </a>
    </section>

    <section aria-labelledby="gallery-heading" class="py-12 border-t border-border">
        <h2 id="gallery-heading">Gallery</h2>
        <p class="mt-4 max-w-prose text-accent">Photos from our shows and events are coming soon.</p>
    </section>

    <section aria-labelledby="sponsors-heading" class="py-12 border-t border-border">
        <h2 id="sponsors-heading">Sponsors</h2>
        <p class="mt-4 max-w-prose text-accent">Sponsor information coming soon.</p>
    </section>

    <section aria-labelledby="charities-heading" class="py-12 border-t border-border">
        <h2 id="charities-heading">Charities</h2>
        <p class="mt-4 max-w-prose text-accent">Charity information coming soon.</p>
    </section>
</Layout>
