---
import fcLogo from '../assets/fc/FC_Line_Logo_Black.png';
import { SITE } from '../config/site';
---

<footer data-cursor-tone="light" class="flex flex-col items-start gap-4 py-12 border-t border-border sm:flex-row sm:items-center sm:justify-between">
    <img src={fcLogo.src} width={fcLogo.width} height={fcLogo.height} alt={SITE.name} class="h-6 w-auto" />
    <p class="text-sm">
        <a href={SITE.linktree} target="_blank" rel="noopener noreferrer"> Find us on Linktree <span class="sr-only">(opens in a new tab)</span> </a>
    </p>
</footer>
